# SPDX-License-Identifier: GPL-2.0-or-later
BasedOnStyle: LLVM
UseTab: Always
IndentWidth: 8
TabWidth: 8
ContinuationIndentWidth: 8
ColumnLimit: 100
BreakBeforeBraces: Linux
IndentCaseLabels: false
AlignAfterOpenBracket: Align
AlignConsecutiveMacros: AcrossEmptyLines
# The Makefile aligns macro values to a tab stop, including across blank lines.
# Preserve that alignment instead of replacing tabs with spaces.
SkipMacroDefinitionBody: true
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BinPackArguments: true
BinPackParameters: true
SpaceBeforeParens: ControlStatements
PointerAlignment: Right
DerivePointerAlignment: false
SpaceInEmptyParentheses: false
Cpp11BracedListStyle: false
SortIncludes: false
IncludeBlocks: Preserve
# Adjust comment indentation while preserving the text and existing line breaks.
ReflowComments: IndentOnly
